# Runtime database used by db:migrate and db:seed.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Supabase external integration gate. The destructive guard additionally
# verifies host=127.0.0.1|localhost, port=54322, database=postgres and native auth helpers.
GREEN_HIVE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
GREEN_HIVE_TEST_TARGET=LOCAL_SUPABASE
GREEN_HIVE_TEST_CONFIRM=DROP_GREEN_HIVE_TEST_SCHEMAS

# Local Auth integration. Obtain local values with `npm run supabase:status`;
# never expose the service-role value to a browser or commit real remote keys.
GREEN_HIVE_SUPABASE_AUTH_URL=http://127.0.0.1:54321
GREEN_HIVE_SUPABASE_PUBLISHABLE_KEY=local-status-output
GREEN_HIVE_SUPABASE_SERVICE_ROLE_KEY=local-status-output-server-only
GREEN_HIVE_AUTH_RECOVERY_REDIRECT=http://127.0.0.1:3000/auth/recovery

# Reference App HTTP runtime. LOCAL_PREVIEW refuses non-loopback app/Auth/database endpoints.
GREEN_HIVE_RUNTIME_MODE=LOCAL_PREVIEW
GREEN_HIVE_APP_ORIGIN=http://127.0.0.1:3000
GREEN_HIVE_HTTP_LOGS=false
GREEN_HIVE_DATABASE_POOL_MAX=5

# Development-only HMAC secret for the deterministic fake billing webhook adapter.
# Replace this placeholder; production/staging values belong only in the hosting secret store.
GREEN_HIVE_FAKE_WEBHOOK_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

NODE_ENV=development

# Hosted staging is configured in Render, never in a committed .env file. It requires:
# NODE_ENV=production
# NODE_EXTRA_CA_CERTS=./config/supabase-root-2021-ca.crt
# GREEN_HIVE_RUNTIME_MODE=HOSTED_STAGING
# GREEN_HIVE_APP_ORIGIN=https://your-service.onrender.com
# PORT is injected by Render
# GREEN_HIVE_STAGING_PROJECT_REF=the confirmed 20-letter project reference
# DATABASE_URL=the dedicated direct/session-pooler URL with sslmode=verify-full
# GREEN_HIVE_SUPABASE_AUTH_URL=https://PROJECT_REF.supabase.co/auth/v1
# GREEN_HIVE_SUPABASE_PUBLISHABLE_KEY=set in Render
# GREEN_HIVE_SUPABASE_SERVICE_ROLE_KEY=set in Render and never exposed to the browser
# GREEN_HIVE_FAKE_WEBHOOK_SECRET=set in Render as a 32-64 byte base64url secret
# GREEN_HIVE_AUTH_RECOVERY_REDIRECT=https://your-service.onrender.com/auth/recovery
