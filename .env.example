# Runtime database used by db:migrate and db:seed.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Supabase external integration gate. The destructive guard additionally
# verifies host=127.0.0.1|localhost, port=54322, database=postgres and native auth helpers.
GREEN_HIVE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
GREEN_HIVE_TEST_TARGET=LOCAL_SUPABASE
GREEN_HIVE_TEST_CONFIRM=DROP_GREEN_HIVE_TEST_SCHEMAS

# Local Auth integration. Obtain local values with `npm run supabase:status`;
# never expose the service-role value to a browser or commit real remote keys.
GREEN_HIVE_SUPABASE_AUTH_URL=http://127.0.0.1:54321
GREEN_HIVE_SUPABASE_PUBLISHABLE_KEY=local-status-output
GREEN_HIVE_SUPABASE_SERVICE_ROLE_KEY=local-status-output-server-only
GREEN_HIVE_AUTH_RECOVERY_REDIRECT=http://127.0.0.1:3000/auth/recovery

# Reference App HTTP runtime. LOCAL_PREVIEW refuses non-loopback app/Auth/database endpoints.
GREEN_HIVE_RUNTIME_MODE=LOCAL_PREVIEW
GREEN_HIVE_APP_ORIGIN=http://127.0.0.1:3000
GREEN_HIVE_HTTP_LOGS=false

NODE_ENV=development
