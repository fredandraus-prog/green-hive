{
  "name": "green-hive",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Green Hive platform monorepo - hosted HTTPS/Auth/RLS acceptance",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "format:check": "node scripts/format-check.mjs",
    "lint": "node scripts/lint.mjs && node scripts/platform-lint.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "security:smoke": "node scripts/security-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -b tsconfig.build.json",
    "build:web": "vite build apps/hive-reference-app --config apps/hive-reference-app/vite.config.mjs",
    "build": "npm run build:types --silent && npm run build:web --silent",
    "test:unit": "npm run build --silent && node --test tests/app-manifest.test.mjs tests/unit/*.test.mjs",
    "test": "npm run test:unit",
    "db:validate": "node scripts/db-validate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:test": "node --test --test-reporter=spec database/tests/embedded-rls.integration.test.mjs",
    "db:test:external": "node --test --test-reporter=spec database/tests/postgres-rls.integration.test.mjs",
    "db:test:supabase": "node scripts/db-test-supabase.mjs",
    "projects:test:supabase": "npm run build --silent && node --test --test-reporter=spec database/tests/project-service.integration.test.mjs",
    "auth:test:supabase": "node scripts/auth-test-supabase.mjs",
    "web:test:supabase": "node scripts/web-test-supabase.mjs",
    "verify:supabase": "npm run db:test:supabase && npm run auth:test:supabase && npm run web:test:supabase",
    "reference-app:start": "node scripts/reference-app-local.mjs",
    "start:hosted": "node apps/hive-reference-app/dist/http-entry.js",
    "hosted:smoke": "node scripts/hosted-smoke.mjs",
    "hosted:security": "node scripts/hosted-security-smoke.mjs",
    "hosted:acceptance": "pwsh -NoProfile -File scripts/staging-database-windows.ps1 hosted-acceptance",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:status": "node scripts/supabase-local.mjs status",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "staging:database:preflight": "pwsh -NoProfile -File scripts/staging-database-windows.ps1 preflight",
    "staging:database:apply": "pwsh -NoProfile -File scripts/staging-database-windows.ps1 apply",
    "staging:database:test": "pwsh -NoProfile -File scripts/staging-database-windows.ps1 test",
    "staging:auth:test": "pwsh -NoProfile -File scripts/staging-database-windows.ps1 auth-test",
    "staging:apply": "node scripts/staging-apply.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:verify-manifest": "node scripts/verify-release-manifest.mjs",
    "verify": "npm run clean && npm run format:check && npm run lint && npm run security:scan && npm run typecheck && npm run test:unit && npm run db:validate && npm run db:test && npm run build && npm run security:smoke"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "pg": "^8.16.0",
    "supabase": "2.115.0",
    "typescript": "^5.9.0",
    "vite": "8.2.1"
  }
}
