{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@green-hive/core": [
        "packages/core/src/index.ts"
      ],
      "@green-hive/auth": [
        "packages/auth/src/index.ts"
      ],
      "@green-hive/audit": [
        "packages/audit/src/index.ts"
      ],
      "@green-hive/projects": [
        "packages/projects/src/index.ts"
      ],
      "@green-hive/billing": [
        "packages/billing/src/index.ts"
      ],
      "@green-hive/entitlements": [
        "packages/entitlements/src/index.ts"
      ],
      "@green-hive/ai": [
        "packages/ai/src/index.ts"
      ],
      "@green-hive/search": [
        "packages/search/src/index.ts"
      ],
      "@green-hive/trust": [
        "packages/trust/src/index.ts"
      ],
      "@green-hive/cost-guard": [
        "packages/cost-guard/src/index.ts"
      ],
      "@green-hive/jobs": [
        "packages/jobs/src/index.ts"
      ],
      "@green-hive/files": [
        "packages/files/src/index.ts"
      ]
    },
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "jsx": "react-jsx"
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
